<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="ЖАНР"
        android:textColor="@color/text_faint"
        android:textSize="11sp" />

    <Button
        android:id="@+id/filterGenre"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/selector_button"
        android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="Любой жанр"
        android:textAllCaps="false"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="ПЕРИОД"
        android:textColor="@color/text_faint"
        android:textSize="11sp" />

    <Button
        android:id="@+id/filterYear"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/selector_button"
        android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="За все время"
        android:textAllCaps="false"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/filterGo"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_accent"
            android:fontFamily="sans-serif-medium"
            android:text="Поехали!"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/filterReset"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/selector_button"
            android:fontFamily="sans-serif-medium"
            android:minWidth="130dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Сбросить"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
