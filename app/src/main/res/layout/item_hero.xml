<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="360dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/heroImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.34"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_scrim" />

    <!-- rezka posters are 2:3; show the full cover instead of only a cropped band -->
    <ImageView
        android:id="@+id/heroPoster"
        android:layout_width="196dp"
        android:layout_height="294dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_card"
        android:contentDescription="@null"
        android:elevation="10dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/heroTextBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="260dp"
        android:layout_marginBottom="18dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="2"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="@color/text"
            android:textSize="46sp" />

        <TextView
            android:id="@+id/heroDesc"
            android:layout_width="620dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="3"
            android:textColor="#D9FFFFFF"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/heroPlay"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:background="@drawable/selector_button"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_play"
                android:fontFamily="sans-serif-medium"
                android:minWidth="200dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="@string/watch"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <Button
                android:id="@+id/heroInfo"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/selector_button"
                android:fontFamily="sans-serif-medium"
                android:minWidth="150dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="Подробнее"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <Button
                android:id="@+id/heroSearch"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/selector_button"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_search"
                android:fontFamily="sans-serif-medium"
                android:minWidth="140dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="@string/search"
                android:textColor="@color/text"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
